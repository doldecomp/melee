# Auto detect text files and enforce Unix-style line endings.
* text=auto eol=lf

# Always use CRLF for Windows batch scripts
# (Don't think this is respected by the pre-commit 'editorconfig-checker' check)
*.bat  text eol=crlf
# Never use CRLF for Unix bash scripts
*.sh -crlf

# decomp-toolkit writes files with LF
config/**/*.txt  text eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.c text
*.h text
*.s text
*.py text
*.mk text
Makefile text

# Denote all files that are truly binary and should not be modified.
*.png binary
