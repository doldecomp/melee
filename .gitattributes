# Auto-detect text files and normalize line endings to native line endings for the platform
* text=auto

# Force strict Unix-style line endings (LF) for shell scripts and dtk config.
*.sh text eol=lf
config/**/*.txt text eol=lf

# Always use CRLF for Windows batch scripts.
*.bat text eol=crlf

# Explicitly declare source/build files as text to ensure Git normalizes them.
*.c text
*.h text
*.s text
*.py text
*.mk text
Makefile text
Doxyfile text

# Denote all files that are truly binary and should not be modified.
*.png binary
